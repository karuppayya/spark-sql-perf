#!/usr/bin/env bash
# This script downloads and runs sbt.
# You can pass arguments to sbt by passing them to this script.

set -o errexit
set -o nounset
set -o pipefail

# Download sbt if it doesn't exist
SBT_VERSION="1.9.7"
SBT_JAR="build/sbt-launch-${SBT_VERSION}.jar"

if [ ! -f "$SBT_JAR" ]; then
  echo "Downloading sbt $SBT_VERSION..."
  mkdir -p build
  curl -L -o "$SBT_JAR" "https://repo1.maven.org/maven2/org/scala-sbt/sbt-launch/${SBT_VERSION}/sbt-launch-${SBT_VERSION}.jar"
fi

# Run sbt with the provided arguments
java -Xmx2G -XX:ReservedCodeCacheSize=256m -XX:MaxMetaspaceSize=512m -jar "$SBT_JAR" "$@"
